# -----------------------------------------------------------------------------
# Aqua Store - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# Configure production values in Vercel Project Settings > Environment Variables.
# NEVER commit real credentials or secret keys to version control.
# -----------------------------------------------------------------------------

# Application URLs (Production domain e.g. https://aqua-sa.com)
NEXT_PUBLIC_SITE_URL=

# Regional & Localization Defaults
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_CURRENCY=SAR
NEXT_PUBLIC_COUNTRY_CODE=SA

# Contact / WhatsApp Business (Saudi format digits only e.g. 9665xxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics & Monitoring (optional / placeholders for Vercel)
# NEXT_PUBLIC_ANALYTICS_ID=
